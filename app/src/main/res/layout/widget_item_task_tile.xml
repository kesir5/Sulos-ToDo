<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/i_wrap"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="2dp"
    android:paddingEnd="4dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/i_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_tile"
        android:gravity="center_vertical"
        android:minHeight="34dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="8dp">

        <FrameLayout
            android:id="@+id/i_bar"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:background="#FFFFFFFF"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/i_check"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="5dp"
            android:src="@drawable/ic_circle"
            android:contentDescription="Erledigen" />

        <TextView
            android:id="@+id/i_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/i_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/i_star"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_star"
            android:contentDescription="Wichtig" />

        <ImageView
            android:id="@+id/i_up"
            android:layout_width="30dp"
            android:layout_height="34dp"
            android:padding="4dp"
            android:src="@drawable/ic_up"
            android:visibility="gone"
            android:contentDescription="Nach oben" />

        <ImageView
            android:id="@+id/i_down"
            android:layout_width="30dp"
            android:layout_height="34dp"
            android:padding="4dp"
            android:src="@drawable/ic_down"
            android:visibility="gone"
            android:contentDescription="Nach unten" />

        <ImageView
            android:id="@+id/i_handle"
            android:layout_width="30dp"
            android:layout_height="34dp"
            android:paddingStart="8dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:src="@drawable/ic_drag"
            android:contentDescription="Verschieben" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/i_div"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/i_div2"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/i_div_thick"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:visibility="gone" />
</LinearLayout>
